# Copie este arquivo para ".env" (mesma pasta) e preencha. O ".env" NUNCA vai para o GitHub.

# Nome do ESP: aparece no Firebase como esps/<nome> (letras, números, - e _)
ESP_NOME=esp01
ESP_MODELO=ESP32

# Sua rede Wi-Fi (2,4 GHz)
WIFI_SSID=
WIFI_SENHA=

# Firebase Realtime Database (host sem https://)
FIREBASE_HOST=amauryesp-active-default-rtdb.firebaseio.com
# Opcional: chave do banco (deixe em branco se as regras do seu banco permitem o ESP gravar)
FIREBASE_AUTH=
